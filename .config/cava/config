[general]
framerate = 60
bar_width = 2
bar_spacing = 1
# stop drawing after 10s of silence
sleep_timer = 10

[color]
# gradient from the active theme: ~/env/themes/<theme>/cava (apply-color.sh reloads it)
theme = 'active'

[smoothing]
# smooth, rounded peaks instead of jagged single bars
monstercat = 1
